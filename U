-- KILL FARM & GOD SLAYER COMBO ENGINE (Auto-Started with 0.1s Timers)
--------------------------------------------------------------------------------
local KhiConfig = {
    KillFarm = true,
    SafeYThreshold = -30
}

local ExecutingUlt = false
local rescuePlatform = Instance.new("Part", Workspace)
rescuePlatform.Name = "Khi_SafePlatform"
rescuePlatform.Size = Vector3.new(30, 2, 30)
rescuePlatform.Anchored, rescuePlatform.CanCollide, rescuePlatform.Transparency = true, true, 1

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function GetClosestTarget()
    local closest, minDist = nil, math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    for _, target in pairs(Players:GetPlayers()) do
        if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (char.HumanoidRootPart.Position - target.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist then minDist = dist closest = target end
            end
        end
    end
    return closest
end

local function HasGodSlayer()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    return (bp and bp:FindFirstChild("God Slayer")) or (char and char:FindFirstChild("God Slayer"))
end

RunService.RenderStepped:Connect(function()
    if not KhiConfig.KillFarm or ExecutingUlt then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local root = char.HumanoidRootPart
    local targetPlayer = GetClosestTarget()

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    if root.Position.Y < KhiConfig.SafeYThreshold then
        rescuePlatform.CFrame = CFrame.new(root.Position.X, 100, root.Position.Z)
        root.CFrame = CFrame.new(root.Position.X, 104, root.Position.Z)
        return
    end

    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        root.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 1.5, 3)
    end
end)

-- Fast Combat Loop (0.1s Interval)
task.spawn(function()
    while true do
        task.wait(0.1)
        if KhiConfig.KillFarm and not ExecutingUlt then
            local godSlayerTool = HasGodSlayer()
            if godSlayerTool then
                ExecutingUlt = true
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Humanoid") then
                    char.Humanoid:EquipTool(godSlayerTool)
                end

                local victim = GetClosestTarget()
                if victim and victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") and char then
                    char.HumanoidRootPart.CFrame = victim.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
                    task.wait(0.05)
                    pressKey(Enum.KeyCode.One)
                    task.wait(0.05)
                    pressKey(Enum.KeyCode.Three)
                    task.wait(0.05)
                    tryClickUltButton()
                end
                ExecutingUlt = false
            else
                local bp = LocalPlayer:FindFirstChild("Backpack")
                local char = LocalPlayer.Character
                if bp and char and char:FindFirstChildOfClass("Humanoid") then
                    for _, tool in pairs(bp:GetChildren()) do
                        if tool:IsA("Tool") then char.Humanoid:EquipTool(tool) end
                    end
                end
                pressKey(Enum.KeyCode.One)
                pressKey(Enum.KeyCode.Two)
                pressKey(Enum.KeyCode.Three)
                pressKey(Enum.KeyCode.Four)
            end
        end
    end
end)

-- Touch Button Execution Loop (0.1s Interval)
task.spawn(function()
    while true do
        task.wait(0.1)
        if KhiConfig.KillFarm and not ExecutingUlt then
            clickButton(jumpButton)
            clickButton(punchButton)
            clickButton(dashButton)
            tryClickUltButton()
        end
    end
end)

