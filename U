-- Webhook Configuration
local WEBHOOK_URL = "" -- Put your Discord Webhook URL here

local function SendWebhook(title, message)
    if WEBHOOK_URL == "" or not request then return end
    pcall(function()
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = 0x7B61FF,
                ["footer"] = { ["text"] = "Project Khi • " .. os.date("%X") }
            }}
        }
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
end

