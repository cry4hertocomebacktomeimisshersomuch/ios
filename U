-- INVISIBLE & DESYNC ENGINE (Finisher & Anti-Death Protection)
--------------------------------------------------------------------------------
local function MakeTransparent(character)
    if not character then return end
    task.spawn(function()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 0.67
            elseif part:IsA("Decal") then
                part.Transparency = 0.67
            end
        end
    end)
end

if LocalPlayer.Character then MakeTransparent(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(newChar)
    newChar:WaitForChild("HumanoidRootPart")
    MakeTransparent(newChar)
end)

function MainEnv()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:WaitForChild("Humanoid")

    -- Anti-Death Protection when health drops to 20% or lower
    humanoid.HealthChanged:Connect(function(health)
        local maxHealth = humanoid.MaxHealth
        if (health / maxHealth) <= 0.20 and health > 0 then
            -- Safely pull back or trigger defensive measures during finisher threshold
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 25, 0)
        end
    end)

    getgenv().connections = getgenv().connections or {}

    task.spawn(function()
        getgenv().ATCH = false 
        getgenv().EN = nil

        task.spawn(function()
            while not getgenv().gay do
                local dist = math.huge
                local live = Workspace:FindFirstChild("Live")
                if live then
                    for _, part in pairs(live:GetChildren()) do
                        if part:IsA("Model") and part:FindFirstChild("HumanoidRootPart") and part ~= char then
                            local distance = (part.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if distance < dist then 
                                dist = distance 
                                getgenv().EN = part.HumanoidRootPart 
                            end 
                        end 
                    end
                end
                task.wait(0.1)
            end
        end)

        task.wait(0.1)
        getgenv().ATCH = true 

        local e = Instance.new('Part')
        _G.P = e 

        local p = Instance.new("Part", char)
        p.Size = Vector3.new(0.5, 0.5, 0.5)
        p.CanCollide, p.CanTouch, p.Anchored, p.Transparency = false, false, true, 1

        local camera = Workspace.CurrentCamera
        local WEIGHT = 15

        RunService:BindToRenderStep("UpdateSubject", Enum.RenderPriority.First.Value, function()
            camera.CameraSubject = p
            if getgenv().val then
                TweenService:Create(p, TweenInfo.new(2/WEIGHT), {Position = e.Position}):Play()
            end
        end)
        getgenv().val = e

        local conn = RunService.Heartbeat:Connect(function(step)
            if not getgenv().EN or not getgenv().EN.Parent then return end
            local old = hrp.CFrame
            local headPart = char:FindFirstChild("Head")
            local old2 = headPart and headPart.CFrame or hrp.CFrame

            hrp.CFrame = CFrame.new(getgenv().EN.CFrame.X, 432, getgenv().EN.CFrame.Z) * CFrame.Angles(math.rad(90), 0, 0)
            e.CFrame = old2

            RunService.RenderStepped:Wait()
            hrp.CFrame = old
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(getgenv().EN.Position.X, hrp.Position.Y, getgenv().EN.Position.Z))
        end)
        table.insert(getgenv().connections, conn)

        repeat task.wait() until getgenv().ATCH == false or humanoid.Health == 0
        e:Destroy()
        p:Destroy()
        RunService:UnbindFromRenderStep("UpdateSubject")
        camera.CameraSubject = char
    end)
end

MainEnv()
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.1)
    MainEnv()
end)

